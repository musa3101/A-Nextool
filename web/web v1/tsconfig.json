{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@clientes/*": ["../clientes/*"],
      "react": ["node_modules/@types/react", "node_modules/react"],
      "react-dom": ["node_modules/@types/react-dom", "node_modules/react-dom"],
      "react/jsx-runtime": ["node_modules/@types/react/jsx-runtime", "node_modules/react/jsx-runtime"],
      "react-router-dom": ["node_modules/react-router-dom"],
      "lucide-react": ["node_modules/lucide-react"]
    }
  },
  "include": ["src", "../clientes"]
}

